# Copy to .env; replace each password placeholder before starting.
USER_PORT=8091
TECHNICIAN_PORT=8092
REPAIR_PORT=8093
MYSQL_ROOT_PASSWORD=replace_root_password
USER_DB_PASSWORD=replace_user_database_password
TECHNICIAN_DB_PASSWORD=replace_technician_database_password
REPAIR_DB_PASSWORD=replace_repair_database_password
# Week05 alternative (compose.monolith.yaml)
APP_PORT=8081
MYSQL_DATABASE=community_repair
MYSQL_USER=community_app
MYSQL_PASSWORD=replace_monolith_database_password

# Week07 Nacos: bind loopback by default; use private VM IP only when needed.
NACOS_BIND_HOST=127.0.0.1
NACOS_CONSOLE_PORT=18088
NACOS_SERVER_PORT=8849
NACOS_GRPC_PORT=9849
NACOS_GROUP=PERSONAL_GROUP
NACOS_NAMESPACE=
NACOS_USERNAME=nacos
NACOS_PASSWORD=replace_nacos_password
NACOS_AUTH_TOKEN=replace_nacos_auth_token
NACOS_AUTH_IDENTITY_KEY=communityIdentity
NACOS_AUTH_IDENTITY_VALUE=replace_nacos_auth_identity_value
